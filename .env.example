# Server
PORT=3000
SITE_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret

# Admin login (created on first seed)
ADMIN_EMAIL=admin@excursionmarrakech.com
ADMIN_PASSWORD=Admin123!

# Booking emails (guest confirmation + admin alert)
# Example for Gmail: use an App Password, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="excursionmarrakech <silversandstravels@gmail.com>"
# Where new-order alerts go (defaults to ADMIN_EMAIL)
BOOKINGS_NOTIFY_EMAIL=silversandstravels@gmail.com

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Publishable key is exposed to the browser
STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# PayPal (https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# Optional tracking (leave empty until ready)
# GOOGLE_SITE_VERIFICATION = content value only (not the full <meta> tag)
# Homepage also has the verification meta hardcoded for Search Console.
META_PIXEL_ID=
GA_MEASUREMENT_ID=G-3JSSYBLXW5
GOOGLE_ADS_ID=AW-760950068
# Optional: conversion label from Google Ads (e.g. booking lead). Leave empty for remarketing/config only.
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=
