{
  "name": "excursionmarrakech",
  "version": "1.0.0",
  "description": "Marrakech excursion booking store with admin, Stripe & PayPal",
  "main": "app.js",
  "scripts": {
    "start": "node --experimental-sqlite app.js",
    "dev": "node --experimental-sqlite --watch server/index.js",
    "seed": "node --experimental-sqlite server/seed.js",
    "db:reset": "rm -f data/store.db && node --experimental-sqlite server/seed.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "stripe": "^17.6.0",
    "uuid": "^11.0.5"
  }
}
